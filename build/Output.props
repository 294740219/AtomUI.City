<Project>
  <PropertyGroup>
    <AtomUICityOutputRoot>$(MSBuildThisFileDirectory)../output</AtomUICityOutputRoot>
    <AtomUICityArtifactsOutputPath>$(AtomUICityOutputRoot)/artifacts/$(Configuration)</AtomUICityArtifactsOutputPath>
    <AtomUICityPackagesOutputPath>$(AtomUICityOutputRoot)/NuGet/$(Configuration)</AtomUICityPackagesOutputPath>
    <AtomUICityLogsOutputPath>$(AtomUICityOutputRoot)/logs/$(Configuration)</AtomUICityLogsOutputPath>
    <AtomUICityTestResultsOutputPath>$(AtomUICityOutputRoot)/test-results/$(Configuration)</AtomUICityTestResultsOutputPath>
    <PackageOutputPath>$(AtomUICityPackagesOutputPath)</PackageOutputPath>
    <OutputPathWithoutFramework>$(MSBuildThisFileDirectory)../output/bin/$(Configuration)/$(MSBuildProjectName)</OutputPathWithoutFramework>
    <OutputPath>$(OutputPathWithoutFramework)</OutputPath>
    <BaseIntermediateOutputPath Condition="'$(AtomUICityIsolatedIntermediateRoot)' == ''">$(MSBuildThisFileDirectory)../output/$(MSBuildProjectName)/obj</BaseIntermediateOutputPath>
    <BaseIntermediateOutputPath Condition="'$(AtomUICityIsolatedIntermediateRoot)' != ''">$(AtomUICityIsolatedIntermediateRoot)/$(MSBuildProjectName)/obj</BaseIntermediateOutputPath>
    <IntermediateOutputPathWithoutFramework>$(BaseIntermediateOutputPath)</IntermediateOutputPathWithoutFramework>
    <IntermediateOutputPath>$(BaseIntermediateOutputPath)/$(Configuration)</IntermediateOutputPath>
    <VSTestResultsDirectory>$(AtomUICityTestResultsOutputPath)</VSTestResultsDirectory>
  </PropertyGroup>
</Project>
