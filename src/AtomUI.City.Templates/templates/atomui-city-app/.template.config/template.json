{
  "$schema": "http://json.schemastore.org/template",
  "author": "AtomUI.City",
  "classifications": [ "AtomUI.City", "Host", "Application" ],
  "identity": "AtomUI.City.Templates.Application",
  "name": "AtomUI.City Application",
  "shortName": "atomui-city-app",
  "sourceName": "AtomUICityApplication",
  "preferNameDirectory": true,
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "sources": [
    {
      "modifiers": [
        {
          "condition": "(!IncludeSample)",
          "exclude": [ "src/AtomUICityApplication/Samples/**" ]
        }
      ]
    }
  ],
  "symbols": {
    "TargetFramework": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": "net10.0",
      "replaces": "__TARGET_FRAMEWORK__"
    },
    "IncludeSample": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false"
    }
  }
}
